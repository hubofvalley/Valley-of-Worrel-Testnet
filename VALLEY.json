{
  "schema": 1,
  "project": "Worrell",
  "network": "Testnet",
  "architecture": "v1",
  "entrypoint": "resources/valleyofWorrel.sh",
  "visibility": "public",
  "public_launcher": "direct",
  "default_branch": "main",
  "components": [
    {
      "id": "validator",
      "kind": "cosmos",
      "binary": "worrelld",
      "service": "worrelld-testnet-2.service",
      "home": "$HOME/.worrell-testnet-2 (or /var/lib/worrell-testnet-2 in root-only mode)",
      "config_paths": [
        "$HOME/.worrell-testnet-2/config/config.toml",
        "$HOME/.worrell-testnet-2/config/app.toml"
      ],
      "dependencies": [],
      "capabilities": [
        "install",
        "update",
        "status",
        "logs",
        "peers",
        "keys",
        "validator_tx",
        "staking_tx",
        "pruning",
        "genesis_ceremony",
        "cosmovisor",
        "cosmovisor_handoff_verification",
        "backup",
        "delete"
      ],
      "ports": [
        {
          "role": "p2p",
          "default": 18656,
          "exposure": "public"
        },
        {
          "role": "rpc",
          "default": 18657,
          "exposure": "loopback"
        },
        {
          "role": "abci",
          "default": 18658,
          "exposure": "loopback"
        },
        {
          "role": "prometheus",
          "default": 18660,
          "exposure": "loopback"
        },
        {
          "role": "api",
          "default": 18317,
          "exposure": "loopback"
        },
        {
          "role": "grpc",
          "default": 18090,
          "exposure": "loopback"
        },
        {
          "role": "grpc-web",
          "default": 18091,
          "exposure": "loopback"
        }
      ]
    }
  ],
  "runtime": {
    "remote_helpers": "pinned_commit",
    "unsafe_skip_backup_default": false
  },
  "live_deployment": {
    "verification_status": "not_yet_live",
    "verified_date": null,
    "port_prefix": 18,
    "ports": {
      "p2p": 18656,
      "rpc": 18657,
      "abci": 18658,
      "prometheus": 18660,
      "api": 18317,
      "grpc": 18090,
      "grpc-web": 18091
    },
    "moniker": null,
    "public_rpc": null,
    "public_websocket": null,
    "public_peer": null,
    "cosmovisor": null,
    "unsafe_skip_backup": false
  }
}
