{
  "schema": 1,
  "project": "Worrell",
  "network": "Testnet",
  "architecture": "v1",
  "entrypoint": "resources/valleyofWorrel.sh",
  "visibility": "public",
  "public_launcher": "direct",
  "default_branch": "main",
  "components": [
    {
      "id": "validator",
      "kind": "cosmos",
      "binary": "worrelld",
      "service": "worrelld.service",
      "home": "$HOME/.worrell (or /var/lib/worrell in root-only mode)",
      "config_paths": [
        "$HOME/.worrell/config/config.toml",
        "$HOME/.worrell/config/app.toml"
      ],
      "dependencies": [],
      "capabilities": [
        "install",
        "update",
        "status",
        "logs",
        "peers",
        "keys",
        "validator_tx",
        "staking_tx",
        "snapshot",
        "pruning",
        "cosmovisor",
        "backup",
        "delete"
      ],
      "ports": [
        {
          "role": "p2p",
          "default": 17656,
          "exposure": "public"
        },
        {
          "role": "rpc",
          "default": 17657,
          "exposure": "loopback"
        },
        {
          "role": "abci",
          "default": 17658,
          "exposure": "loopback"
        },
        {
          "role": "prometheus",
          "default": 17660,
          "exposure": "loopback"
        },
        {
          "role": "api",
          "default": 17317,
          "exposure": "loopback"
        },
        {
          "role": "grpc",
          "default": 17090,
          "exposure": "loopback"
        },
        {
          "role": "grpc-web",
          "default": 17091,
          "exposure": "loopback"
        }
      ]
    }
  ],
  "runtime": {
    "remote_helpers": "pinned_commit"
  },
  "live_deployment": {
    "verified_date": "2026-09-11",
    "port_prefix": 17,
    "ports": {
      "p2p": 17656,
      "rpc": 17657,
      "abci": 17658,
      "prometheus": 17660,
      "api": 17317,
      "grpc": 17090,
      "grpc-web": 17091
    },
    "moniker": "grandvalley-lightnode",
    "public_rpc": "https://lightnode-rpc-worrell.grandvalleys.com",
    "public_websocket": "wss://lightnode-rpc-worrell.grandvalleys.com/websocket",
    "public_peer": "e812f08760b18ed774369e899763735f80179f76@peer-worrell.grandvalleys.com:17656",
    "cosmovisor": true,
    "unsafe_skip_backup": true
  }
}
